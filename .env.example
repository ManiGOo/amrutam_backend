# Copy to .env — never commit .env
APP_NAME=amrutam
APP_ENV=local
API_V1_PREFIX=/v1
LOG_LEVEL=INFO

# Postgres primary (RW) — app writes here
DATABASE_URL=postgresql+asyncpg://amrutam:amrutam@postgres-primary:5432/amrutam
# Postgres replica (RO) — search/analytics
REPLICA_DATABASE_URL=postgresql+asyncpg://amrutam:amrutam@postgres-replica:5432/amrutam
POSTGRES_PASSWORD=amrutam

REDIS_URL=redis://redis:6379/0
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=rx-pdfs

# JWT RS256 — entrypoint generates ONE pair into the shared jwt-secrets volume
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem
JWT_KID=local-1
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

# Day 3: Rx KEK must be base64(32 random bytes) in prod; dev default is NOT secret
PRESCRIPTION_KEK_B64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
PAYMENT_WEBHOOK_SECRET=local-webhook-secret

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# OTEL_ENABLED=true only in compose/prod (tests + plain local runs skip tracing)
OTEL_ENABLED=false
